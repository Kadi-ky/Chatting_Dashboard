# ─────────────────────────────────────────────────────────────────────────────
# Backend — copy to .env.local (git-ignored) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# Account this worker is running against. One worker = one creator account.
# Must be a row in v3.accounts.
ACCOUNT_ID=

# ─── Postgres (Supabase) ─────────────────────────────────────────────────────
# Use the pooler connection string (port 6543) for the app; direct 5432 for migrations.
DATABASE_URL=postgres://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Redis (queues, locks, rate limits) ──────────────────────────────────────
# Local dev: redis://localhost:6379
# Prod: use Upstash or managed Redis.
REDIS_URL=redis://localhost:6379

# ─── LLM: primary (Grok) ─────────────────────────────────────────────────────
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL_GENERATOR=grok-4
GROK_MODEL_CLASSIFIER=grok-4-1-fast-reasoning

# ─── LLM: fallback (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=nousresearch/nous-hermes-2-mixtral-8x7b-dpo
OPENROUTER_CLASSIFIER_FALLBACK_MODEL=mistralai/mistral-small

# ─── Platform (kept name-agnostic in code) ───────────────────────────────────
# "mock" = in-memory adapter (outbound sends captured, not delivered). Use for local
#          testing via the V3 Testing Ground tab. No PLATFORM_API_KEY required.
# "http" = real platform adapter; PLATFORM_API_KEY + PLATFORM_API_BASE required.
PLATFORM_MODE=http
PLATFORM_API_KEY=
PLATFORM_API_BASE=
PLATFORM_WEBHOOK_SECRET=

# ─── Admin HTTP surface (frontend V3 Testing tab talks to this) ──────────────
ADMIN_PORT=8787
# Bearer token for /admin/* — must match VITE_V3_ADMIN_TOKEN in the frontend.
ADMIN_TOKEN=

# ─── Tuning knobs (sensible defaults; override only if needed) ───────────────
BURST_WINDOW_MS=4000
CONVERSATION_LOCK_TTL_MS=60000
OUTBOUND_MIN_GAP_MS=20000
WHALE_SPEND_30D_CENTS=50000
PPV_COOLDOWN_DAYS=14
