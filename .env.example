# ─────────────────────────────────────────────────────────────────────────────
# Chatting Dashboard — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored, so your keys stay private.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Go to https://supabase.com/dashboard → select your project
# 2. Open "Project Settings" → "API" in the left sidebar
# 3. Copy the values shown under "Project URL" and "Project API keys"

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: filter all queries to a single creator.
# Leave blank to see data across ALL creators in the database.
VITE_CREATOR_UUID=
